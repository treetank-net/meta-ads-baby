{
  "name": "meta-ads-baby-server",
  "version": "0.14.2",
  "description": "Meta (Facebook) Ads MCP server with two-phase mutation safety",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npx esbuild dist/index.js --bundle --platform=node --target=node18 --format=cjs --minify --outfile=bundle.cjs",
    "dev": "tsc --watch",
    "start": "node bundle.cjs",
    "test": "META_ADS_BABY_DATA=\"${TMPDIR:-/tmp}/meta-ads-baby-test\" tsc -p tsconfig.test.json && META_ADS_BABY_DATA=\"${TMPDIR:-/tmp}/meta-ads-baby-test\" node dist-test/test/smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
